{
  "name": "brimec-asistente",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MVP navegable del asistente conversacional integrado al ERP de BRIMEC (T-09 / T-10). Demo academica, sin backend ni LLM reales.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "probar": "esbuild scripts/probar-nlu.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=node_modules/.cache/probar.cjs --log-level=error && node node_modules/.cache/probar.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
